{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_API_URL=https://api.github.com",
        "ghcr.io/github/github-mcp-server"
      ]
    }
  }
}
import "@typespec/http";

using TypeSpec.Http;

/**
 * Модели и правила предметной области «Календарь звонков».
 *
 * Глобальные правила, фиксируемые контрактом:
 * 1. Сетка слотов — 30 минут. Все начала слотов выровнены по получасам.
 *    Событие длительностью больше 30 минут занимает подряд идущие слоты
 *    и блокирует их все.
 * 2. Занятость: на одно и то же время нельзя создать две записи,
 *    даже если это разные типы событий (пересечение интервалов запрещено).
 * 3. Окно записи: доступные слоты формируются на ближайшие 14 дней,
 *    начиная с текущей даты. Бронь вне окна отклоняется.
 * 4. Часовой пояс: у календаря единая фиксированная таймзона
 *    (см. CALENDAR_TIME_ZONE). Все времена в API передаются как utcDateTime;
 *    сервер интерпретирует и отображает их в таймзоне календаря.
 */
namespace CallCalendar;

/** Таймзона календаря. Единая для владельца и всех гостей. */
const CALENDAR_TIME_ZONE: string = "Europe/Moscow";

/** Шаг сетки слотов в минутах. */
const SLOT_GRID_MINUTES: int32 = 30;

/** Размер окна записи в днях, начиная с текущей даты. */
const BOOKING_WINDOW_DAYS: int32 = 14;

/**
 * Тип события, созданный владельцем календаря.
 * Идентификатор задаёт сам владелец при создании.
 */
model EventType {
  /**
   * Уникальный идентификатор типа события.
   * Задаётся владельцем: непустая строка из строчных латинских букв,
   * цифр и дефисов (slug), например "intro-call".
   */
  id: string;

  /** Название типа события, например "Вводный звонок". */
  name: string;

  /** Описание типа события. */
  description?: string;

  /**
   * Длительность в минутах.
   * Должна быть положительной и кратной шагу сетки (30 минут).
   */
  durationMinutes: int32;
}

/** Краткая карточка типа события для страницы «виды брони». */
model EventTypeSummary {
  id: string;
  name: string;
  description?: string;
  durationMinutes: int32;
}

/** Гость бронирует без регистрации и входа в систему. */
model Guest {
  /** Имя гостя. */
  name: string;

  /** Email гостя в формате RFC 5322. */
  @pattern("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")
  email: string;
}

/**
 * Слот календаря длительностью 30 минут.
 * Для событий длиннее 30 минут свободность определяется по всей
 * последовательности перекрываемых слотов.
 */
model Slot {
  /** Начало слота (выровнено по получасам). */
  startTime: utcDateTime;

  /** Конец слота (startTime + 30 минут). */
  endTime: utcDateTime;

  /** Свободен ли слот с учётом существующих броней всех типов событий. */
  available: boolean;
}

/** Запрос на создание типа события владельцем. */
model CreateEventTypeRequest {
  ...EventType;
}

/** Запрос гостя на бронирование слота. */
model CreateBookingRequest {
  /** Идентификатор выбранного типа события. */
  eventTypeId: string;

  /**
   * Начало выбранного свободного слота.
   * Должно быть выровнено по получасам и попадать в окно записи
   * (ближайшие 14 дней от текущей даты).
   */
  startTime: utcDateTime;

  /** Данные гостя. */
  guest: Guest;
}

/**
 * Бронирование. Показывается владельцу в едином списке предстоящих встреч
 * вместе с информацией о типе события.
 */
model Booking {
  /** Идентификатор бронирования (генерируется сервером). */
  id: string;

  /** Тип события, на который создана бронь. */
  eventType: EventTypeSummary;

  /** Гость, создавший бронь. */
  guest: Guest;

  /** Начало встречи. */
  startTime: utcDateTime;

  /** Конец встречи (startTime + длительность типа события). */
  endTime: utcDateTime;
}

// --- Ошибки -----------------------------------------------------------------

@error
model ValidationError {
  @statusCode _: 422;

  code: "VALIDATION_ERROR";

  /** Человекочитаемое описание нарушения: неверный формат id, длительность не кратна 30, время вне окна записи или вне сетки получасов. */
  message: string;
}

@error
model NotFoundError {
  @statusCode _: 404;

  code: "NOT_FOUND";

  /** Тип события или другой ресурс не найден. */
  message: string;
}

/**
 * Нарушение правила занятости: на запрошенное время уже существует бронь
 * (пересечение интервалов), независимо от типа события.
 */
@error
model SlotConflictError {
  @statusCode _: 409;

  code: "SLOT_CONFLICT";

  message: string;
}

/** Владелец попытался создать тип события с уже существующим id. */
@error
model DuplicateEventTypeIdError {
  @statusCode _: 409;

  code: "DUPLICATE_EVENT_TYPE_ID";

  message: string;
}

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "UpcomingMeetings.json",
    "type": "object",
    "properties": {
        "bookings": {
            "type": "array",
            "items": {
                "$ref": "Booking.json"
            },
            "description": "Бронирования всех типов событий."
        }
    },
    "required": [
        "bookings"
    ],
    "description": "Список предстоящих встреч для владельца.\nСодержит бронирования всех типов событий, отсортированные по времени."
}
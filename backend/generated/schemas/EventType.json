{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "EventType.json",
    "type": "object",
    "properties": {
        "id": {
            "$ref": "EntityId.json",
            "description": "Числовой идентификатор типа события."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Название типа события, уникальное в системе."
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "description": "Описание типа события."
        },
        "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "Длительность события в минутах."
        }
    },
    "required": [
        "id",
        "name",
        "description",
        "durationMinutes"
    ],
    "description": "Тип события"
}
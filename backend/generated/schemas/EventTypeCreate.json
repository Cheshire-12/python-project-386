{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "EventTypeCreate.json",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Название типа события."
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "description": "Описание типа события."
        },
        "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "Длительность события в минутах."
        }
    },
    "required": [
        "name",
        "description",
        "durationMinutes"
    ],
    "description": "Данные для создания типа события владельцем."
}